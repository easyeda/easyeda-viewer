{
  "name": "easyeda-viewer",
  "version": "0.2.0",
  "description": "Lightweight single-file viewer for EasyEDA Pro .epro2/.eprj3 projects (local parse & render with LeaferJS)",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "test": "vitest run",
    "smoke": "vite-node -c vite.smoke.config.ts scripts/smoke.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "leafer-ui": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "lucide-static": "^1.46.0",
    "puppeteer-core": "^25.11.0",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.1.0"
  }
}
