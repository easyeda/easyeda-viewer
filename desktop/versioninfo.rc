#include <windows.h>
#include <winver.h>

// EasyEDA Viewer desktop shell resources (#18):
//  - ICON #1: window/exe icon (loaded by desktop_windows.go loadAppIcon "#1")
//  - VS_VERSION_INFO: file properties (version, author, copyright…)
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,4,1,0
 PRODUCTVERSION 0,4,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0x0804 (zh-CN) / 0x04b0 (UTF-16 codepage)
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "easyeda-viewer (Apache-2.0)"
            VALUE "FileDescription", "EasyEDA 查看器 — 本地 .epro2/.eprj3 轻量查看器"
            VALUE "FileVersion", "0.4.1"
            VALUE "LegalCopyright", "Apache License 2.0"
            VALUE "OriginalFilename", "easyeda-viewer_v0.4.1.exe"
            VALUE "ProductName", "EasyEDA Viewer"
            VALUE "ProductVersion", "0.4.1"
            VALUE "Author", "summving"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
